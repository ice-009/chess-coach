{
  "name": "chess-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node --experimental-strip-types scripts/validate-data.ts",
    "test:layout": "node tests/layout.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:quiz": "node --experimental-strip-types --no-warnings tests/quiz.mjs",
    "start": "vite build && vite preview --port 5173 --open",
    "ipad": "node --experimental-strip-types --no-warnings scripts/ipad.ts",
    "db:update": "node --experimental-strip-types --no-warnings scripts/db/update.ts",
    "db:export": "node --experimental-strip-types --no-warnings scripts/db/export.ts",
    "puzzles:update": "node --experimental-strip-types --no-warnings scripts/puzzles/build.ts",
    "build:static": "tsc -b && VITE_STATIC_HOST=1 vite build",
    "deploy": "node --experimental-strip-types --no-warnings scripts/deploy.ts",
    "test:account": "node tests/account.mjs",
    "test:account-api": "node --experimental-strip-types --no-warnings tests/account-api.ts",
    "test:offline": "node tests/offline.mjs",
    "puzzles:export": "node --experimental-strip-types --no-warnings scripts/puzzles/export-static.ts public/puzzles",
    "test:board": "node tests/board.mjs",
    "test:moments": "node --experimental-strip-types --no-warnings tests/keyMoments.mjs",
    "test:quick": "node tests/quickReview.mjs",
    "test:safety": "node --experimental-strip-types --no-warnings tests/safety.mjs",
    "test:safe-drill": "node --experimental-strip-types --no-warnings tests/safetyDrill.mjs",
    "test:clock": "node --experimental-strip-types --no-warnings tests/clockStats.mjs",
    "test:coach": "node tests/coach.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "chess.js": "^1.4.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "1.63",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
