{
  "name": "chess-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node --experimental-strip-types scripts/validate-data.ts",
    "start": "vite build && vite preview --port 5173 --open",
    "db:update": "node --experimental-strip-types --no-warnings scripts/db/update.ts",
    "puzzles:update": "node --experimental-strip-types --no-warnings scripts/puzzles/build.ts",
    "build:static": "tsc -b && VITE_STATIC_HOST=1 vite build && node --experimental-strip-types --no-warnings scripts/puzzles/export-static.ts dist/puzzles"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "chess.js": "^1.4.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.2.8",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
